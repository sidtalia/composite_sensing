<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>composite_sensing</name>
  <version>0.0.0</version>
  <description>
    Composite sensing: stereo+cuVSLAM and lidar SDK composite (in-process deskew).
    Standalone mesh particle filter (mesh_pf_node): Vulkan RT or Embree.
  </description>
  <maintainer email="hound@todo.todo">hound</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>eigen</depend>
  <depend>std_srvs</depend>
  <depend>librealsense2</depend>
  <depend>libopencv-dev</depend>
  <build_depend>assimp</build_depend>

  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
